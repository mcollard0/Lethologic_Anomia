# Migration Service Environment Configuration
# Copy this file to .env and set your actual values
# NEVER commit .env files with real API keys to version control!

# ==============================================================================
# AI PROVIDER API KEYS (Optional - all loaded from environment for security)
# ==============================================================================

# XAI (Grok) API Key - Get from https://console.x.ai/
# XAI_API_KEY=xai-your-api-key-here

# Anthropic (Claude) API Key - Get from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# OpenAI API Key - Get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your-api-key-here

# Hugging Face API Token (PAID service - last priority) - Get from https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=hf_your-api-token-here

# ==============================================================================
# AI PROVIDER CONFIGURATION
# ==============================================================================

# AI Provider Priority Order (comma-separated, local models first, paid APIs last)
# Available providers: huggingface_local, xai, anthropic, openai, huggingface_api
# Default prioritizes free local model first, then paid APIs, HF API last (most expensive)
AI_PROVIDERS=huggingface_local,xai,anthropic,openai,huggingface_api

# Model Configuration
AI_LOCAL_MODEL=microsoft/DialoGPT-medium
XAI_MODEL=grok-beta
ANTHROPIC_MODEL=claude-3-haiku-20240307
OPENAI_MODEL=gpt-3.5-turbo
HUGGINGFACE_MODEL=microsoft/DialoGPT-large

# API Endpoints
XAI_BASE_URL=https://api.x.ai/v1
HF_BASE_URL=https://api-inference.huggingface.co

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# Primary Database URL (SQLite by default for simplicity)
DATABASE_URL=sqlite:///./migration_service.db

# Optional: External database connections
# SQL_SERVER_URL=mssql+pyodbc://username:password@server/database?driver=ODBC+Driver+17+for+SQL+Server
# ORACLE_URL=oracle+cx_oracle://username:password@host:port/?service_name=service
# MYSQL_URL=mysql+pymysql://username:password@host:port/database
# MONGODB_URL=mongodb://username:password@host:port/database

# ==============================================================================
# REDIS/VALKEY CONFIGURATION
# ==============================================================================

REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=your-redis-password-if-needed

# ==============================================================================
# DICOM SERVICE CONFIGURATION
# ==============================================================================

DICOM_SCP_PORT=50104
DICOM_OUR_AE_TITLE=MIGRATION_SCP
DICOM_STORAGE_DIR=./dicom_storage

# SSL Settings (optional)
# DICOM_SSL_ENABLED=true
# DICOM_SSL_CERT=path/to/cert.pem
# DICOM_SSL_KEY=path/to/key.pem

# ==============================================================================
# HL7/FHIR CONFIGURATION
# ==============================================================================

HL7_PORT=50575
HL7_ENABLED=true
FHIR_ENABLED=true
FHIR_VERSION=R4
HL7_INPUT_DIR=./hl7_input
HL7_OUTPUT_DIR=./hl7_output

# ==============================================================================
# WEB INTERFACE CONFIGURATION
# ==============================================================================

WEB_INTERFACE_ENABLED=true
WEB_PORT=50443
WEB_SSL_ENABLED=true

# IMPORTANT: Change this in production!
WEB_SECRET_KEY=change-me-in-production-please

# SSL Certificates (required if SSL enabled)
# WEB_SSL_CERT=path/to/web-cert.pem
# WEB_SSL_KEY=path/to/web-key.pem

# ==============================================================================
# SSH SERVER CONFIGURATION
# ==============================================================================

SSH_ENABLED=true
SSH_PORT=50022

# SSH Authentication (set one or both)
# SSH_PASSWORD=your-ssh-password
# SSH_AUTHORIZED_KEYS=path/to/authorized_keys

# SSH Host Key (optional - will generate if not provided)
# SSH_HOST_KEY=path/to/ssh_host_key

# ==============================================================================
# LOGGING AND ENVIRONMENT
# ==============================================================================

# Environment: development, testing, production
ENVIRONMENT=production

# Logging
LOG_LEVEL=INFO
# LOG_FILE=./logs/migration_service.log

# Debug mode (only enable for development!)
DEBUG=false
TESTING=false

# ==============================================================================
# DIRECTORY CONFIGURATION
# ==============================================================================

BASE_DIR=.
CONFIG_DIR=./config
DATA_DIR=./data

# ==============================================================================
# SECURITY NOTES
# ==============================================================================

# 1. NEVER commit .env files with real API keys to version control
# 2. Set file permissions: chmod 600 .env
# 3. Use different keys for development/testing/production
# 4. Rotate API keys regularly
# 5. Monitor API usage and costs
# 6. Use API key restrictions where available (IP, domain, etc.)

# ==============================================================================
# COST MANAGEMENT
# ==============================================================================

# AI Provider Priority is designed for cost optimization:
# 1. Local HuggingFace (FREE) - Always tried first
# 2. XAI Grok (Paid, competitive pricing) 
# 3. Anthropic Claude (Paid, moderate pricing)
# 4. OpenAI GPT (Paid, higher pricing)
# 5. HuggingFace API (Paid, highest pricing for inference)

# To minimize costs:
# - Keep local models as first priority
# - Set usage limits on paid APIs
# - Monitor your API usage dashboards
# - Consider setting up billing alerts
