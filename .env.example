# Lethologic Anomia Configuration
# Copy this file to .env and customize as needed

# Database Configuration
DATABASE_URL=sqlite:///./lethologic_anomia.db

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0

# DICOM Configuration
DICOM_SCP_PORT=50104
DICOM_SCP_SSL_PORT=50112
DICOM_OUR_AE_TITLE=MIGRATION_SCP
DICOM_AUTO_START_SCP=true
DICOM_AUTO_START_SSL=true
DICOM_SSL_ENABLED=false
DICOM_STORAGE_DIR=./dicom_storage

# Web Interface Configuration (includes FHIR endpoints)
WEB_INTERFACE_ENABLED=true
WEB_PORT=50443
WEB_SSL_ENABLED=true
WEB_SSL_CERT=etc/key/certificate.pem
WEB_SSL_KEY=etc/key/private.key

# SSH Server Configuration
SSH_ENABLED=true
SSH_PORT=50022
SSH_HOST_KEY=etc/key/ssh_host_key

# HL7/FHIR Configuration
HL7_ENABLED=true
HL7_PORT=50575
FHIR_ENABLED=true
FHIR_VERSION=R4

# AI Configuration (optional)
#OPENAI_API_KEY=your_key_here
#ANTHROPIC_API_KEY=your_key_here
#XAI_API_KEY=your_key_here

# Logging
LOG_LEVEL=INFO
DEBUG=false
